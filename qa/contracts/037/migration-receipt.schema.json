{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsched.local/qa/contracts/037/migration-receipt.schema.json",
  "title": "Task 037 migration fixture receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "fixture_id", "before_revision", "after_revision", "expected_inner_exit", "actual_inner_exit", "expected_sqlstate", "actual_sqlstate", "before_catalog_sha256", "after_catalog_sha256", "before_row_sha256", "after_row_sha256", "rollback_confirmed", "cleanup_link", "oracle"],
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "const": "037-migration-receipt/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "fixture_id": { "enum": ["empty-roundtrip", "batch-nonempty", "item-nonempty", "dispatch-cancelled", "dispatch-exhausted"] },
    "before_revision": { "enum": ["0011", "0012"] },
    "after_revision": { "enum": ["0011", "0012"] },
    "expected_inner_exit": { "type": "string", "enum": ["ZERO", "NONZERO"] },
    "actual_inner_exit": { "type": "integer" },
    "expected_sqlstate": { "type": ["string", "null"], "pattern": "^[0-9A-Z]{5}$" },
    "actual_sqlstate": { "type": ["string", "null"], "pattern": "^[0-9A-Z]{5}$" },
    "before_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "after_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "before_row_sha256": { "$ref": "#/$defs/sha256" },
    "after_row_sha256": { "$ref": "#/$defs/sha256" },
    "rollback_confirmed": { "const": true },
    "cleanup_link": { "type": "string", "minLength": 1 },
    "oracle": { "enum": ["PASS_NEGATIVE_23514_UNCHANGED", "PASS_EMPTY_0011_CATALOG_AND_REUPGRADE"] }
  }
}
