{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsched.local/qa/contracts/037/candidate-provenance.schema.json",
  "title": "Task 037 candidate and dependency provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repo", "remote_url", "candidate_ref", "candidate_sha", "candidate_tree_sha", "queried_at_utc", "candidate_pr", "dependencies"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "headRefName", "headRefOid", "baseRefName", "baseRefOid", "state", "isDraft", "required_checks", "queried_at_utc", "raw_receipt_path", "raw_receipt_sha256"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$" },
        "headRefName": { "type": "string", "minLength": 1 },
        "headRefOid": { "$ref": "#/$defs/git_sha" },
        "baseRefName": { "const": "develop" },
        "baseRefOid": { "$ref": "#/$defs/git_sha" },
        "state": { "enum": ["OPEN", "MERGED"] },
        "isDraft": { "const": false },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "conclusion"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "const": "COMPLETED" },
              "conclusion": { "enum": ["SUCCESS", "NEUTRAL", "SKIPPED"] }
            }
          }
        },
        "queried_at_utc": { "$ref": "#/$defs/utc" },
        "raw_receipt_path": { "type": "string", "pattern": "^raw/github/[^/]+\\.json$" },
        "raw_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "037-candidate-provenance/v1" },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "remote_url": { "type": "string", "pattern": "^(https://github\\.com/|git@github\\.com:)" },
    "candidate_ref": { "type": "string", "minLength": 1 },
    "candidate_sha": { "$ref": "#/$defs/git_sha" },
    "candidate_tree_sha": { "$ref": "#/$defs/git_sha" },
    "queried_at_utc": { "$ref": "#/$defs/utc" },
    "candidate_pr": { "$ref": "#/$defs/pr" },
    "dependencies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "spec_path", "spec_sha256", "head_oid", "base_oid", "review_envelope_path", "review_envelope_sha256", "pr", "lineage_verified"],
        "properties": {
          "dependency_id": { "enum": ["035A", "035B", "036"] },
          "spec_path": { "type": "string", "pattern": "^agent-tasks/" },
          "spec_sha256": { "$ref": "#/$defs/sha256" },
          "head_oid": { "$ref": "#/$defs/git_sha" },
          "base_oid": { "$ref": "#/$defs/git_sha" },
          "review_envelope_path": { "type": "string", "pattern": "^raw/reviews/[^/]+\\.json$" },
          "review_envelope_sha256": { "$ref": "#/$defs/sha256" },
          "pr": { "$ref": "#/$defs/pr" },
          "lineage_verified": { "const": true }
        }
      }
    }
  }
}
