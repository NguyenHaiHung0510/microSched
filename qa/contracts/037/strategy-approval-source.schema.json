      "properties": {
        "scope_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["037.strategy.risk_based_baseline", "037.order.freeze_review_then_tier1_then_owner_gate_then_tier2", "037.tier1.local_ci_synthetic", "037.tier2.owner_sync_then_scrubbed_neon_develop", "037.tier3.narrow_read_only_smoke_when_separately_authorized", "037.physical_iphone.separate_acceptance"] },
          "allOf": [
            { "contains": { "const": "037.strategy.risk_based_baseline" } },
            { "contains": { "const": "037.order.freeze_review_then_tier1_then_owner_gate_then_tier2" } },
            { "contains": { "const": "037.tier1.local_ci_synthetic" } },
            { "contains": { "const": "037.tier2.owner_sync_then_scrubbed_neon_develop" } },
            { "contains": { "const": "037.tier3.narrow_read_only_smoke_when_separately_authorized" } },
            { "contains": { "const": "037.physical_iphone.separate_acceptance" } }
