    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "turn_id", "message_id", "message_created_at_utc", "message_uuidv7_unix_ms", "exact_text", "exact_text_sha256_utf8", "capture_method"],
      "properties": {
        "thread_id": { "const": "01a0439a-145f-7740-a33e-bff6e0b97661" },
        "turn_id": { "const": "01a04653-da34-7503-9ee8-747967734936" },
        "message_id": { "const": "01a04655-0e97-7560-94dd-47cb95d9fbe2" },
        "message_created_at_utc": { "const": "2026-08-28T03:06:14.551Z" },
