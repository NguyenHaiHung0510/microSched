{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsched.local/qa/contracts/037/run-manifest.schema.json",
  "title": "Task 037 immutable run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_sha",
    "candidate_tree_sha",
    "candidate_ref",
    "candidate_worktree",
    "expected_production_sha",
    "started_at_utc",
    "executor",
    "spec_hashes",
    "expected_authority_hashes",
    "commands_sha256",
    "candidate_provenance_sha256",
    "strategy_approval_binding",
    "manifest_core_sha256",
    "git_status_porcelain_z_sha256"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "properties": {
    "schema_version": { "const": "037-run-manifest/v1" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "candidate_sha": { "$ref": "#/$defs/git_sha" },
    "candidate_tree_sha": { "$ref": "#/$defs/git_sha" },
    "candidate_ref": { "type": "string", "minLength": 1 },
    "candidate_worktree": { "type": "string", "minLength": 3 },
    "expected_production_sha": {
      "oneOf": [
        { "$ref": "#/$defs/git_sha" },
        { "type": "null" }
      ]
    },
    "started_at_utc": { "$ref": "#/$defs/utc" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "identity", "model", "reasoning_effort"],
      "properties": {
        "lane": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] }
      }
    },
    "spec_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["035A", "035B", "036", "037"],
      "properties": {
        "035A": { "$ref": "#/$defs/sha256" },
        "035B": { "$ref": "#/$defs/sha256" },
        "036": { "$ref": "#/$defs/sha256" },
        "037": { "$ref": "#/$defs/sha256" }
      }
    },
    "expected_authority_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority-receipts.schema.json",
        "review-envelope.schema.json",
        "expected-authority-review.schema.json",
        "strategy-approval-source.schema.json",
        "command-contract.v1.json",
        "matrix-inventory.v1.json",
        "expected-catalog-fixtures.v1.json",
        "catalog-queries.v1.sql"
      ],
      "patternProperties": {
        "^(authority-receipts\\.schema\\.json|review-envelope\\.schema\\.json|expected-authority-review\\.schema\\.json|strategy-approval-source\\.schema\\.json|command-contract\\.v1\\.json|matrix-inventory\\.v1\\.json|expected-catalog-fixtures\\.v1\\.json|catalog-queries\\.v1\\.sql)$": { "$ref": "#/$defs/sha256" }
      }
    },
    "commands_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_provenance_sha256": { "$ref": "#/$defs/sha256" },
    "strategy_approval_binding": { "$ref": "strategy-approval-binding.schema.json" },
    "manifest_core_sha256": { "$ref": "#/$defs/sha256" },
    "git_status_porcelain_z_sha256": { "$ref": "#/$defs/sha256" }
  }
}
